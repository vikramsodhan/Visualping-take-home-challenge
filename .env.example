# Copy to .env and fill in. .env is gitignored and must stay that way.

# Homepage of the site to crawl, including scheme. The crawl stays on this origin.
BASE_URL=

# HTTP Basic Auth credentials, sent on every in-scope request.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Optional. Defaults shown.
# OUT_DIR=out
# REQUEST_TIMEOUT_MS=30000
# MAX_REDIRECTS=10
# REQUEST_DELAY_MS=100        # pause between fetches, to stay a polite guest
# MAX_PAGES=700               # safety net; a clean crawl empties the frontier well below this
# PAGINATION_SAMPLE=25        # pages to sample from any ?page=N sequence before treating it as a trap
